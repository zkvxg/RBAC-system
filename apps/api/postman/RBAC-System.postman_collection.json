                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"moderator-updated\",\n  \"description\": \"Updated role\",\n  \"permissions\": [\"users.view\", \"users.edit\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/roles/{{roleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "roles", "{{roleId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Role",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/roles/{{roleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "roles", "{{roleId}}"]
            }
