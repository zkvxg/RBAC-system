{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "allowJs": true,
    "checkJs": false
  },
  "include": ["**/*.ts", "**/*.js"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "playwright-report",
    "test-results",
    "playwright.config.js",
    "eslint.config.js"
  ]
}
