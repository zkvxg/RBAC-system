{
  "name": "@rbac/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx db/cli.ts migrate",
    "db:migrate:undo": "tsx db/cli.ts undo",
    "db:migrate:undo:all": "tsx db/cli.ts undo-all",
    "db:migrate:status": "tsx db/cli.ts status",
    "db:seed": "tsx db/cli.ts seed",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:reset": "tsx db/cli.ts reset",
    "lint": "eslint .",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report playwright-report",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:integration": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@rbac/shared": "*",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sequelize": "^6.31.1",
    "sqlite3": "^6.0.1",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@playwright/test": "^1.58.2",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^8.57.1",
    "globals": "^15.15.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
