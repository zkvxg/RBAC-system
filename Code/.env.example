# Copy this file to `.env.local` and adjust values as needed.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Set to "false" to use the real backend instead of in-memory mocks.
# Any other value (or missing) keeps the app in mock mode.
VITE_USE_MOCKS=true

# Base URL of the backend API (used when VITE_USE_MOCKS=false).
# Backend default port is 5000.
VITE_API_URL=http://localhost:5000
